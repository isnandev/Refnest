{
  "name": "refnest",
  "private": true,
  "type": "module",
  "version": "0.5.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run sidecar:build && bun run --filter @refnest/desktop tauri:dev",
    "build": "bun run sidecar:build && bun run --filter @refnest/desktop tauri:build",
    "sidecar:build": "bun scripts/build-sidecar.ts",
    "server:dev": "bun run --filter @refnest/server dev",
    "mcp:stdio": "bun run --filter @refnest/server mcp:stdio",
    "smoke": "bun scripts/smoke-sidecar.ts",
    "typecheck": "tsc -p tsconfig.json && bun run --filter '@refnest/*' typecheck",
    "test": "bun run --filter '@refnest/*' test",
    "check:rust": "cargo check --manifest-path apps/desktop/src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@refnest/contracts": "workspace:*",
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "~5.8.3"
  }
}
